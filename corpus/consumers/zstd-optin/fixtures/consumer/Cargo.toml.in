[package]
name = "toucan-zstd-consumer"
version = "0.0.0"
edition = "2021"
rust-version = "1.64"
publish = false

[workspace]

[features]
toucan = ["zstd/toucan"]
bindgen = ["zstd/bindgen"]
experimental = ["zstd/experimental"]
zstdmt = ["zstd/zstdmt"]

[dependencies]
zstd = { version = "=0.13.3", path = "../zstd-rs" }
