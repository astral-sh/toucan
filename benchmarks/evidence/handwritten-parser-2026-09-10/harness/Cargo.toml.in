[package]
name = "toucan-parser-comparison"
version = "0.0.0"
edition = "2024"
rust-version = "1.96"
publish = false

[workspace]

[dependencies]
serde = { version = "1", features = ["derive"] }
serde_json = "1"
toucan = { path = "__TOUCAN_SOURCE__/crates/toucan" }
toucan_bindgen = { path = "__TOUCAN_SOURCE__/crates/toucan_bindgen" }
toucan_parser = { path = "__TOUCAN_SOURCE__/crates/toucan_parser" }

[features]
allocations = []

[profile.release]
lto = "fat"
codegen-units = 1
debug = 0
strip = false
